{
  "name": "@crosshands/contract",
  "version": "0.1.6",
  "description": "Versioned computer-use contract shared by CrossHands adapters and providers",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "schemas"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:schemas": "pnpm build && node dist/generate-schemas.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
