{
  "name": "@crosshands/cli",
  "version": "0.2.2",
  "description": "Agent-agnostic local computer-use CLI",
  "license": "MIT",
  "bin": {
    "crosshands": "dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test"
  },
  "dependencies": {
    "@crosshands/contract": "workspace:*",
    "@crosshands/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "optionalDependencies": {
    "@crosshands/platform-darwin": "workspace:*",
    "@crosshands/platform-linux": "workspace:*",
    "@crosshands/platform-windows": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
